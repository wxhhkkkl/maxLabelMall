# IDE
.idea/
*.iml
.vscode/

# 依赖与构建缓存（storefront/ 另有自己的 .gitignore 管它自己的 node_modules/dist）
# 根目录这个是 vitest 留下的缓存目录，不该入库
node_modules/
__pycache__/

# 敏感信息（服务器地址、密码等），禁止提交
.env
.env.local
*.env

# 例外：storefront 的 .env 只有非敏感配置（标题/租户/端口/输出目录），
# 而**租户号必须随仓库走** —— 它决定前台连的是哪一套数据。
# 后端地址与凭据仍在 .env.local（仍被忽略）。
!storefront/.env

# 模块建表 SQL：除仓库自带的两个外，其余是按模块从芋道知识星球下载的授权材料，不入库
# （这两个是 yudao 仓库自带的，保持跟踪）
yudao-cloud/sql/mysql/*.sql
!yudao-cloud/sql/mysql/ruoyi-vue-pro.sql
!yudao-cloud/sql/mysql/quartz.sql
# ⚠️ 例外：**本项目自己写**的迁移脚本要入库。
# 忽略规则是给"下载来的付费资产"用的，而迁移脚本是部署的一部分 ——
# 不入库的话，别人（或换台机器）部署时会**静默漏掉这一步**，而漏掉的表现是
# "运营在后台选不到某个选项"，很难倒推回这里。
!yudao-cloud/sql/mysql/0*.sql

# 旧商城导出数据：含 91 个客户手机号、收件人姓名与联系电话，属个人信息，禁止入库
# （导入脚本 scripts/import_legacy_mall.py 以它作为输入，但它本身不进版本库）
data-collection*.xlsx
# 导入前备份（是一整份线上数据快照，同样含个人信息）
scripts/_backup/

# 旧商城全量抓取快照：含 91 个会员的手机号/地址/密码哈希、395 张订单的收件人
# 姓名与联系电话，属个人信息；另含后台会话缓存。抓取脚本 scripts/scrape_old_mall.py 入库，
# 它产出的数据本身不进版本库。
oldMallData/

# 旧商城财务流水台账：含会员编号/昵称、每笔充值消费的金额与支付时间，属个人信息
scripts/legacy-mall-finance-archive.csv

# 一次性代码生成脚手架：产物已落到 storefront/src/ 下，脚本本身是一次性的，不复用
_gen_base.py
_scaffold1.py
_scaffold2.py

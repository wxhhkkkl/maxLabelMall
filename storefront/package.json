{
  "name": "maxlabel-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "ts:check": "vue-tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "1.16.0",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.15",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "3.5.34",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "8.1.4",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.2.8"
  }
}
# 管理端部署到线上服务器（152.136.105.223）的 /admin/ 子路径 —— 用法：pnpm build:deploy
#
# ⚠️ 构建变量写在文件里、不用命令行前缀，原因同 storefront/.env.production：
#    git-bash(MSYS2) 会把 `/admin/`、`/admin-api` 这类以 / 开头的参数改写成本机路径
#    （实测把 /app-api 写成了 D:/Program Files/Git/app-api），打进产物后页面全空。
#    写进 .env 文件不经过 shell，不可能被改写。
#
# VITE_BASE_URL 留空 + VITE_API_URL=/admin-api ⇒ 接口走**同源**相对路径，
# 由 nginx 反代到 127.0.0.1:48080（对外只需 80，且天然没有 CORS）。
#
# VITE_BASE_PATH=/admin/ 是构建时烘焙的，router 的 createWebHistory 和
# 静态资源路径都依赖它 —— 改这个值就必须同时改服务器上的目录与 nginx location。
VITE_DEV=false
VITE_BASE_URL=
VITE_API_URL=/admin-api
VITE_BASE_PATH=/admin/

# ⚠️ **不能留空这组变量**：`.env` 里上游默认值是「芋道源码 / admin / admin123」，
#    LoginForm.vue 会把它 `|| ''` 后直接预填进输入框。管理端是公网可达的，
#    预填 = 把平台超管的默认口令摆在登录页上（超管能看所有租户的数据）。
#    这里清空用户名与密码，只留业务租户名当默认值 —— 登录时只需填自己的账号。
VITE_APP_DEFAULT_LOGIN_TENANT=御旺宸发
VITE_APP_DEFAULT_LOGIN_USERNAME=
VITE_APP_DEFAULT_LOGIN_PASSWORD=

# ⚠️ **必须在这里显式打开**：`.env` 里上游本来就是 true，但 `.env.local` 把它压成了
#    false —— Vite 在**所有 mode** 下都会加载 `.env.local`，且优先级高于 `.env`，
#    而 `.env.deploy` 在这之后加载、优先级更高，所以只有写在这里才盖得住。
#    服务端 `yudao.captcha.enable=true` 时，后台登录会**强制要求** captchaVerification
#    （AdminAuthServiceImpl.doValidateCaptcha），前端不送就是
#    「请求参数不正确:验证码不能为空」——2026-10-09 线上真的这么挂过一次，
#    排查了半天才发现是这个开关被 .env.local 静默关掉。
VITE_APP_CAPTCHA_ENABLE=true
